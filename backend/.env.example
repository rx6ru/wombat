# ----------------------------
# Supabase Configuration
# ----------------------------

# Full database URL (with connection pooling enabled)
SUPABASE_DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?pgbouncer=true"

# Direct database URL (without pooling)
SUPABASE_DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# Supabase project URL
SUPABASE_URL="https://<YOUR_SUPABASE_PROJECT>.supabase.co"

# Supabase service role secret key
SUPABASE_SECRET_KEY="<YOUR_SUPABASE_SECRET_KEY>"

# Supabase client publishable key
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"

# JWKS URL for verifying JWT tokens
SUPABASE_JWKS_URL="https://<YOUR_SUPABASE_PROJECT>.supabase.co/auth/v1/.well-known/jwks.json"

# Redis config from Upstash
UPSTASH_REDIS_REST_URL="<YOUR_UPSTASH_REDIS_REST_URL>"
UPSTASH_REDIS_REST_TOKEN="<YOUR_UPSTASH_REDIS_REST_TOKEN>"

# ----------------------------
# Server Configuration
# ----------------------------

# Server port
PORT=8000
# Frontend localhost is on 3000 which results in misconfigurations

# Node environment (development, production, etc.)
NODE_ENV=development
