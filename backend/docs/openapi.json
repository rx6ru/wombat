{
  "openapi": "3.1.0",
  "info": {
    "title": "Wombat Backend API",
    "version": "1.0.0",
    "description": "Interactive OpenAPI contract for the currently implemented Wombat backend API. This covers the active /api/v1 user and API key endpoints."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Relative v1 API base path"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "User",
      "description": "Authenticated user profile bootstrap and username management."
    },
    {
      "name": "API Keys",
      "description": "Authenticated API key storage, search, retrieval, update, and deletion."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token provided as a Bearer token."
      }
    },
    "schemas": {
      "AuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Unauthorized"
          },
          "details": {
            "type": "string",
            "example": "jwt expired"
          },
          "code": {
            "type": "string",
            "example": "TOKEN_EXPIRED"
          }
        },
        "required": [
          "error"
        ]
      },
      "BasicError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Server error"
          },
          "details": {
            "type": "string",
            "example": "Unexpected internal error"
          }
        },
        "required": [
          "error"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "error"
        ]
      },
      "RateLimitError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Too many requests. Please wait before trying again."
          }
        },
        "required": [
          "error"
        ]
      },
      "UserInfoResponse": {
        "type": "object",
        "properties": {
          "namePresent": {
            "type": "boolean",
            "example": true
          },
          "username": {
            "type": "string",
            "example": "existing-username"
          }
        },
        "required": [
          "namePresent",
          "username"
        ]
      },
      "UpdateUserInfoRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "username"
        ]
      },
      "UpdateUserInfoResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Profile updated successfully"
          },
          "profile": {
            "$ref": "#/components/schemas/UpdatedProfile"
          }
        },
        "required": [
          "message",
          "profile"
        ]
      },
      "UpdatedProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid"
          },
          "username": {
            "type": "string",
            "example": "new-username"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-05-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "updatedAt"
        ]
      },
      "ApiKeyMetadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid"
          },
          "name": {
            "type": "string",
            "example": "OpenAI prod"
          },
          "service": {
            "type": [
              "string",
              "null"
            ],
            "example": "openai"
          },
          "reqSample": {
            "example": {
              "model": "gpt-4.1"
            }
          },
          "resSample": {
            "example": {
              "ok": true
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "example": "Production usage"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-05-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-05-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginatedApiKeyList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiKeyMetadata"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "example": "uuid-or-null"
          },
          "hasMore": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "data",
          "nextCursor",
          "hasMore"
        ]
      },
      "FetchKeyResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "sk-live-plaintext-secret"
          }
        },
        "required": [
          "key"
        ]
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "OpenAI prod"
          },
          "service": {
            "type": "string",
            "maxLength": 50,
            "example": "openai"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "example": "sk-live-plaintext-secret"
          },
          "reqSample": {
            "example": {
              "model": "gpt-4.1"
            }
          },
          "resSample": {
            "example": {
              "ok": true
            }
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "example": "Production usage"
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        },
        "required": [
          "name",
          "key"
        ]
      },
      "UpdateApiKeyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "OpenAI prod"
          },
          "service": {
            "type": "string",
            "maxLength": 50,
            "example": "openai"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "example": "sk-live-plaintext-secret"
          },
          "reqSample": {
            "example": {
              "model": "gpt-4.1"
            }
          },
          "resSample": {
            "example": {
              "ok": true
            }
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "example": "Production usage"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/user/info/getUserInfo": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get current user profile info",
        "description": "Returns username information for the authenticated user. If the local profile does not exist yet, the backend creates it during this request.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current username information for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/user/info/updateUserInfo": {
      "put": {
        "tags": [
          "User"
        ],
        "summary": "Update current username",
        "description": "Updates the stored username for the authenticated user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserInfoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Username updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateUserInfoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid username payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "Local profile was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Profile not found"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/key/keys": {
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "List stored API keys",
        "description": "Returns paginated API key metadata for the authenticated user. Plaintext secret values are never returned by this endpoint.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Cursor for paginated reads.",
              "example": "uuid"
            },
            "required": false,
            "description": "Cursor for paginated reads.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated API key metadata list.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "string"
                },
                "description": "Configured limit for the current window."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "string"
                },
                "description": "Remaining requests in the current window."
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "string"
                },
                "description": "Rate limit reset timestamp returned by Upstash."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedApiKeyList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/key/keys/search": {
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "Search stored API keys",
        "description": "Searches the authenticated user's API key metadata by name, service, or description.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Search term used across name, service, and description.",
              "example": "openai"
            },
            "required": true,
            "description": "Search term used across name, service, and description.",
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Cursor for paginated reads.",
              "example": "uuid"
            },
            "required": false,
            "description": "Cursor for paginated reads.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated API key metadata list filtered by the search term.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedApiKeyList"
                }
              }
            }
          },
          "400": {
            "description": "Missing search query or invalid cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationError"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "string",
                          "enum": [
                            "Missing search query"
                          ]
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/key/key/{id}": {
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "Fetch plaintext API key value",
        "description": "Returns the decrypted plaintext secret value for a stored API key record owned by the authenticated user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "API key record id",
              "example": "uuid"
            },
            "required": true,
            "description": "API key record id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Plaintext API key value.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "string"
                },
                "description": "Configured limit for the current window."
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "string"
                },
                "description": "Remaining requests in the current window."
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "string"
                },
                "description": "Rate limit reset timestamp returned by Upstash."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FetchKeyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing key id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Missing key id"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "Key not found or not owned by the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Key not found"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "API Keys"
        ],
        "summary": "Update stored API key record",
        "description": "Partially updates an existing stored API key record owned by the authenticated user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "API key record id",
              "example": "uuid"
            },
            "required": true,
            "description": "API key record id",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated API key metadata record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyMetadata"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure, missing key id, or empty update payload.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationError"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "string",
                          "enum": [
                            "Missing key id"
                          ]
                        }
                      },
                      "required": [
                        "error"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "string",
                          "enum": [
                            "No update fields provided"
                          ]
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "Key not found or not owned by the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Key not found"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "API Keys"
        ],
        "summary": "Delete stored API key record",
        "description": "Deletes an API key record owned by the authenticated user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "API key record id",
              "example": "uuid"
            },
            "required": true,
            "description": "API key record id",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "API key record deleted successfully."
          },
          "400": {
            "description": "Missing key id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Missing key id"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "Key not found or not owned by the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Key not found"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/key/key": {
      "post": {
        "tags": [
          "API Keys"
        ],
        "summary": "Create stored API key record",
        "description": "Validates and stores a new API key record for the authenticated user. The plaintext secret is encrypted before persistence.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created API key metadata record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyMetadata"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure for the create payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
